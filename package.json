{
  "name": "id-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "source ~/.nvm/nvm.sh && nvm use 20.10.0 && doppler run -- nest start --watch",
    "start:debug": "source ~/.nvm/nvm.sh && nvm use 20.10.0 && nest start --debug --watch",
    "start:prod": "node -r newrelic dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test:dev": "doppler run -- jest",
    "test": "jest",
    "test:watch": "doppler run -- jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "docker:start": "doppler run -- docker compose up -d && npx prisma migrate reset",
    "prisma:migrate": "source ~/.nvm/nvm.sh && nvm use 20.10.0 && doppler run -- npx prisma migrate dev && npx prisma generate",
    "prisma:studio": "source ~/.nvm/nvm.sh && nvm use 20.10.0 &&doppler run -- npx prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^9.0.0",
    "@nestjs/config": "^2.2.0",
    "@nestjs/core": "^9.0.0",
    "@nestjs/platform-express": "^9.0.0",
    "@ntegral/nestjs-sentry": "^4.0.0",
    "@prisma/client": "^5.6.0",
    "@segment/analytics-node": "^2.0.0",
    "@sentry/node": "^7.31.1",
    "@sentry/tracing": "^7.31.1",
    "@types/multer": "^1.4.7",
    "@types/sharp": "^0.31.1",
    "argon2": "^0.30.3",
    "aws-sdk": "^2.1360.0",
    "axios": "^1.2.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "crypto": "^1.0.1",
    "dotenv": "^16.0.3",
    "form-data": "^4.0.0",
    "helmet": "^6.0.1",
    "jsonwebtoken": "^9.0.0",
    "mailgun-js": "^0.22.0",
    "mailgun.js": "^8.0.6",
    "moment": "^2.29.4",
    "nanoid": "^3.3.4",
    "newrelic": "^9.10.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.2.0",
    "sharp": "^0.32.0",
    "winston": "^3.8.2",
    "wretch": "^2.7.1"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^10.6.1",
    "@nestjs/cli": "^9.0.0",
    "@nestjs/schematics": "^9.0.0",
    "@nestjs/testing": "^9.0.0",
    "@types/express": "^4.17.13",
    "@types/jest": "29.2.4",
    "@types/node": "^18.14.0",
    "@types/nodemailer": "^6.4.7",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "29.3.1",
    "prettier": "^2.3.2",
    "prisma": "^5.6.0",
    "prisma-erd-generator": "^1.11.1",
    "source-map-support": "^0.5.20",
    "supertest": "^6.3.3",
    "ts-jest": "29.0.3",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "4.1.1",
    "typescript": "^4.7.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
